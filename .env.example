# Phase 4: LLM provider config. Copy this file to .env and fill in your values.
# agent.py works unmodified with any OpenAI-compatible chat completions endpoint --
# only these three variables change between providers.

# --- Option A: Groq (free tier, fast, supports tool calling) ---
# Get a free API key at https://console.groq.com/keys
# As of mid-2026, llama-3.1-8b-instant and llama-3.3-70b-versatile are
# Enterprise-only on Groq -- the current free/developer-tier production
# models are the openai/gpt-oss-* family. Check https://console.groq.com/docs/models
# for what's current if this stops working; Groq's lineup changes over time.
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-120b

# --- Option B: local Ollama (no API key, no internet needed after the model pull) ---
# 1. Install Ollama, then: ollama pull llama3.1
# 2. Uncomment these two lines and comment out the Groq block above:
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# --- Option C: OpenAI ---
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Note: tool-calling support varies by provider/model. Groq's larger models and
# recent Ollama models (llama3.1+, qwen2.5, mistral-nemo) support it; older or
# smaller local models may not, in which case the agent will just answer from
# retrieved context without ever calling calc_baud_rate_ubrr / calc_adc_prescaler.
